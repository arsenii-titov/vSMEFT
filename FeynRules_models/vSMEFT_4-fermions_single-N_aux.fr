  (* O_duNe: charged vector auxiliaries. *)
  V[201] == {ClassName -> xduNeUm, ClassMembers -> {xduNeUm1,xduNeUm2,xduNeUm3},
    Indices -> {Index[Generation]}, FlavorIndex -> Generation, SelfConjugate -> False, Mass -> 0, Width -> 0,
    QuantumNumbers -> {Q -> -1}, PropagatorLabel -> {"XVN_U","XVN_U1","XVN_U2","XVN_U3"},
    PropagatorType -> Wavy, PropagatorArrow -> Forward, PDG -> {9020011,9020012,9020013},
    ParticleName -> {"x_dune_um_1","x_dune_um_2","x_dune_um_3"},
    AntiParticleName -> {"x_dune_up_1","x_dune_up_2","x_dune_up_3"}},
  V[202] == {ClassName -> xduNeVm, ClassMembers -> {xduNeVm1,xduNeVm2,xduNeVm3},

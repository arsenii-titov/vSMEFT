    AntiParticleName -> {"x_dune_vp_1","x_dune_vp_2","x_dune_vp_3"}},

  (* Unphysical gauge-multiplet containers used only to write compact gauge-invariant interactions. *)
  S[221] == {ClassName -> xLNLeU, Unphysical -> True,
    Indices -> {Index[SU2D],Index[Generation]}, FlavorIndex -> SU2D, SelfConjugate -> False,
    QuantumNumbers -> {Y -> -1/2}, Definitions -> {xLNLeU[1,ff_] :> xLNLeU0[ff], xLNLeU[2,ff_] :> xLNLeUm[ff]}},
  S[222] == {ClassName -> xLNLeV, Unphysical -> True,
    Indices -> {Index[SU2D],Index[Generation]}, FlavorIndex -> SU2D, SelfConjugate -> False,
    QuantumNumbers -> {Y -> -1/2}, Definitions -> {xLNLeV[1,ff_] :> xLNLeV0[ff], xLNLeV[2,ff_] :> xLNLeVm[ff]}},
  S[223] == {ClassName -> xLNQdU, Unphysical -> True,
    Indices -> {Index[SU2D],Index[Generation]}, FlavorIndex -> SU2D, SelfConjugate -> False,

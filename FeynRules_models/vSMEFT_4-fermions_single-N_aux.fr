(* **************************************************************************************************************** *)
(* MadGraph-compatible auxiliary-field implementation of the single-N dimension-6 four-fermion vSMEFT operators.    *)
(*                                                                                                                  *)
(* This file replaces vSMEFT_4-fermions.fr.  Load it after SM_v_Majorana.fr and vSM.fr.                             *)
(* Every four-fermion contact term is represented by two three-point vertices joined by a non-propagating           *)
(* auxiliary field.  For every current channel two auxiliaries, U and V, are used. Their UFO propagators are        *)
(* +i/Lambda^2 and -i/Lambda^2.  The U/V sum cancels all current-current self contractions and leaves only the      *)
(* requested cross-current operator plus its Hermitian conjugate.                                                   *)
(*                                                                                                                  *)
(* IMPORTANT: after WriteUFO, run patch_vSMEFT_aux_ufo.py on the generated UFO directory.                           *)
(* The patch installs the constant propagators and marks all auxiliaries as non-propagating.                        *)
(*                                                                                                                  *)
(* The model contains one NR field, NR[...,1].  The corresponding fixed HNL label is not retained as a redundant    *)
(* Wilson-coefficient index: all five coefficient tensors therefore carry only the three SM-generation indices.     *)
(* **************************************************************************************************************** *)

M$ModelName = "vSMEFT_4-fermions_single-N_aux";

M$Information = {
  Authors      -> {"A. Titov", "auxiliary-field reformulation prepared with Codex"},
  Version      -> "2.0",
  Date         -> "10 August 2026",
  Institutions -> {"University of Padua"},
  Emails       -> {"arsenii.titov@unipd.it"},
  References   -> {"G.Cottin, J.C. Helo, M. Hirsch, A. Titov and Z.S. Wang, JHEP 09 (2021) 039 [arXiv:2105.13851]",
                   "R. Beltran, G. Cottin, J.C. Helo, M. Hirsch, A. Titov and Z.S. Wang, JHEP 01 (2022) 044 [arXiv:2110.15096]",
                   "A. Titov, arXiv:2511.10733"},
  URLs         -> {"https://github.com/arsenii-titov/vSMEFT.git"}
};

FeynmanGauge = True;

M$Parameters = {
  (*gAux4F == {
    ParameterType -> Internal, Value -> 1,
    InteractionOrder -> {AUX,1}, TeX -> Subscript[g,aux],
    Description -> "Unit bookkeeping coupling for non-propagating four-fermion auxiliaries"
  },*)
  cLNLe == {
    ParameterType -> External, BlockName -> OPERATORLNLe,
    Indices -> {Index[Generation],Index[Generation],Index[Generation]},
    ComplexParameter -> False,
    Value -> {cLNLe[i_?NumericQ,j_?NumericQ,k_?NumericQ] -> 0.0},
    InteractionOrder -> {NP,1}, TeX -> Subscript[c,LNLe],
    Description -> "Wilson coefficients cLNLe"
  },
  cduNe == {
    ParameterType -> External, BlockName -> OPERATORduNe,
    Indices -> {Index[Generation],Index[Generation],Index[Generation]},
    ComplexParameter -> False,
    Value -> {cduNe[i_?NumericQ,j_?NumericQ,k_?NumericQ] -> 0.0},
    InteractionOrder -> {NP,1}, TeX -> Subscript[c,duNe],
    Description -> "Wilson coefficients cduNe"
  },
  cLNQd == {
    ParameterType -> External, BlockName -> OPERATORLNQd,
    Indices -> {Index[Generation],Index[Generation],Index[Generation]},
    ComplexParameter -> False,
    Value -> {cLNQd[i_?NumericQ,j_?NumericQ,k_?NumericQ] -> 0.0},
    InteractionOrder -> {NP,1}, TeX -> Subscript[c,LNQd],
    Description -> "Wilson coefficients cLNQd"
  },
  cLdQN == {
    ParameterType -> External, BlockName -> OPERATORLdQN,
    Indices -> {Index[Generation],Index[Generation],Index[Generation]},
    ComplexParameter -> False,
    Value -> {cLdQN[i_?NumericQ,j_?NumericQ,k_?NumericQ] -> 0.0},
    InteractionOrder -> {NP,1}, TeX -> Subscript[c,LdQN],
    Description -> "Wilson coefficients cLdQN"
  },
  cQuNL == {
    ParameterType -> External, BlockName -> OPERATORQuNL,
    Indices -> {Index[Generation],Index[Generation],Index[Generation]},
    ComplexParameter -> False,
    Value -> {cQuNL[i_?NumericQ,j_?NumericQ,k_?NumericQ] -> 0.0},
    InteractionOrder -> {NP,1}, TeX -> Subscript[c,QuNL],
    Description -> "Wilson coefficients cQuNL"
  }
};

M$InteractionOrderHierarchy = {{QCD,1},{QED,2},{NP,2},{AUX,3}};

(* Physical auxiliary fields. All masses are placeholders; the UFO patch replaces them by Lambda solely as the     *)
(* normalization in the constant propagator. They cannot occur as external states after propagating=False is set.   *)

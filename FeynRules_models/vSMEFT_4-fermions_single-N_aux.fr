    Indices -> {Index[SU2D],Index[Generation]}, FlavorIndex -> SU2D, SelfConjugate -> False,
    QuantumNumbers -> {Y -> -1/2}, Definitions -> {xQuNLU[1,ff_] :> xQuNLU0[ff], xQuNLU[2,ff_] :> xQuNLUm[ff]}},
  S[226] == {ClassName -> xQuNLV, Unphysical -> True,
    Indices -> {Index[SU2D],Index[Generation]}, FlavorIndex -> SU2D, SelfConjugate -> False,
    QuantumNumbers -> {Y -> -1/2}, Definitions -> {xQuNLV[1,ff_] :> xQuNLV0[ff], xQuNLV[2,ff_] :> xQuNLVm[ff]}},
  S[227] == {ClassName -> xLdQNU, Unphysical -> True,
    Indices -> {Index[SU2D],Index[Generation],Index[Colour]}, FlavorIndex -> SU2D, SelfConjugate -> False,
    QuantumNumbers -> {Y -> 1/6}, Definitions -> {
      xLdQNU[1,ff_,cc_] :> xLdQNUu[ff,cc], xLdQNU[2,ff_,cc_] :> xLdQNUd[ff,cc]}},
  S[228] == {ClassName -> xLdQNV, Unphysical -> True,
    Indices -> {Index[SU2D],Index[Generation],Index[Colour]}, FlavorIndex -> SU2D, SelfConjugate -> False,
    QuantumNumbers -> {Y -> 1/6}, Definitions -> {
      xLdQNV[1,ff_,cc_] :> xLdQNVu[ff,cc], xLdQNV[2,ff_,cc_] :> xLdQNVd[ff,cc]}}
};

(* For a channel J1 J2 + h.c., the pattern is
     ( U J1 - Ubar C J2 + V J1 + Vbar C J2 )/Sqrt[2] + h.c.
   together with Prop(U)=+i/Lambda^2 and Prop(V)=-i/Lambda^2.
   The relative sign compensates the two three-point vertex factors and retains +C J1 J2/Lambda^2. *)

LauxLNLe := Block[{bare,ii,jj,sp1,sp2,ff1,ff2,ff3},
  bare = ExpandIndices[(
      gAux4F xLNLeU[ii,ff1] LLbar[sp1,ii,ff1].NR[sp1,1]
    - xLNLeUbar[ii,ff1] cLNLe[ff1,ff2,ff3] Eps[ii,jj] LLbar[sp2,jj,ff2].lR[sp2,ff3]
    + gAux4F xLNLeV[ii,ff1] LLbar[sp1,ii,ff1].NR[sp1,1]
    + xLNLeVbar[ii,ff1] cLNLe[ff1,ff2,ff3] Eps[ii,jj] LLbar[sp2,jj,ff2].lR[sp2,ff3]
    )/Sqrt[2]];
  bare + HC[bare]
];

LauxLNQd := Block[{bare,ii,jj,sp1,sp2,cc,ff1,ff2,ff3},
  bare = ExpandIndices[(
      gAux4F xLNQdU[ii,ff1] LLbar[sp1,ii,ff1].NR[sp1,1]
    - xLNQdUbar[ii,ff1] cLNQd[ff1,ff2,ff3] Eps[ii,jj] QLbar[sp2,jj,ff2,cc].dR[sp2,ff3,cc]
    + gAux4F xLNQdV[ii,ff1] LLbar[sp1,ii,ff1].NR[sp1,1]
    + xLNQdVbar[ii,ff1] cLNQd[ff1,ff2,ff3] Eps[ii,jj] QLbar[sp2,jj,ff2,cc].dR[sp2,ff3,cc]
    )/Sqrt[2]];
  bare + HC[bare]
];

LauxQuNL := Block[{bare,ii,sp1,sp2,cc,ff1,ff2,ff3},
  bare = ExpandIndices[(
      gAux4F xQuNLUbar[ii,ff3] NRbar[sp1,1].LL[sp1,ii,ff3]
    - xQuNLU[ii,ff3] cQuNL[ff1,ff2,ff3] QLbar[sp2,ii,ff1,cc].uR[sp2,ff2,cc]
    + gAux4F xQuNLVbar[ii,ff3] NRbar[sp1,1].LL[sp1,ii,ff3]
    + xQuNLV[ii,ff3] cQuNL[ff1,ff2,ff3] QLbar[sp2,ii,ff1,cc].uR[sp2,ff2,cc]
    )/Sqrt[2]];
  bare + HC[bare]
];

LauxLdQN := Block[{bare,ii,jj,sp1,sp2,cc,ff1,ff2,ff3},
  bare = ExpandIndices[(
      gAux4F xLdQNU[jj,ff3,cc] QLbar[sp2,jj,ff3,cc].NR[sp2,1]
    - xLdQNUbar[jj,ff3,cc] cLdQN[ff1,ff2,ff3] Eps[ii,jj] LLbar[sp1,ii,ff1].dR[sp1,ff2,cc]
    + gAux4F xLdQNV[jj,ff3,cc] QLbar[sp2,jj,ff3,cc].NR[sp2,1]
    + xLdQNVbar[jj,ff3,cc] cLdQN[ff1,ff2,ff3] Eps[ii,jj] LLbar[sp1,ii,ff1].dR[sp1,ff2,cc]
    )/Sqrt[2]];
  bare + HC[bare]
];

LauxduNe := Block[{bare,mu,sp1,sp2,sp3,sp4,cc,ff1,ff2,ff3},
  bare = ExpandIndices[(
      gAux4F xduNeUmbar[mu,ff3] NRbar[sp3,1].Ga[mu,sp3,sp4].lR[sp4,ff3]
    - xduNeUm[mu,ff3] cduNe[ff1,ff2,ff3] dRbar[sp1,ff1,cc].Ga[mu,sp1,sp2].uR[sp2,ff2,cc]
    + gAux4F xduNeVmbar[mu,ff3] NRbar[sp3,1].Ga[mu,sp3,sp4].lR[sp4,ff3]
    + xduNeVm[mu,ff3] cduNe[ff1,ff2,ff3] dRbar[sp1,ff1,cc].Ga[mu,sp1,sp2].uR[sp2,ff2,cc]
    )/Sqrt[2]];
  bare + HC[bare]
];


(* ******************************************************** *)
(* *****   Full single-N four-fermion Lagrangian      ***** *)
(* ******************************************************** *)

LN4fermions1Aux := LauxLNLe + LauxduNe + LauxLNQd + LauxLdQN + LauxQuNL;

Leff4fermions1Aux := LNSM + LN4fermions1Aux;